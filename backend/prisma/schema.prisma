generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PAYMENT_PENDING
  BLOCKED
}

enum AccessStatus {
  LIBERADO
  PAGAMENTO_PENDENTE
  BLOQUEADO
  CANCELADO
}

enum UserRole {
  USER
  ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AlertType {
  OVER_BUDGET
  BUDGET_WARNING
  CATEGORY_INCREASE
  PACING_WARNING
  INCOME_DECREASE
  EXPENSE_INCREASE
  FECHAMENTO_MENSAL
  ORIENTACAO_D5
  ORIENTACAO_D2
  CONTA_ATRASADA
  VARIACAO_SUBCATEGORIA
  VARIACAO_CATEGORIA
  RECEBIMENTO_ATRASADO
}

enum AlertOrigin {
  IA
  BACKEND
}

enum MonthClosingStatus {
  PENDENTE
  FECHADO
}

enum MonthClosingClassification {
  POSITIVO
  EQUILIBRADO
  NEGATIVO
}

enum MonthClosingOrigin {
  IA
  FALLBACK
}

enum MonthProjectionClassification {
  PREVISAO_POSITIVA
  PREVISAO_EQUILIBRADA
  PREVISAO_NEGATIVA
}

enum MonthProjectionOrigin {
  IA
  FALLBACK
}

enum MonthProjectionD2Variation {
  MELHOROU
  PRATICAMENTE_IGUAL
  PIOROU
}

enum AlertSeverity {
  INFO
  WARNING
  DANGER
}

enum AlertStatus {
  ACTIVE
  READ
  DISMISSED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

model User {
  id             String      @id @default(cuid())
  name           String
  email          String      @unique
  passwordHash   String
  status         UserStatus  @default(ACTIVE)
  accessStatus   AccessStatus @default(LIBERADO)
  role           UserRole     @default(USER)
  mpCustomerId      String?
  planExpiresAt     DateTime?
  trialExpiresAt    DateTime?
  hasSeenWelcome    Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  categories     Category[]
  transactions   Transaction[]
  budgets        Budget[]
  alerts         Alert[]
  payments       Payment[]
  closings       MonthClosing[]
  projections    MonthProjection[]
  projectionsD2  MonthProjectionD2[]
}

model Category {
  id           String   @id @default(cuid())
  name         String
  type         TransactionType
  icon         String   @default("tag")
  color        String   @default("#6366F1")
  isDefault    Boolean  @default(false)
  userId       String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, type])
}

model Transaction {
  id          String           @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Decimal          @db.Decimal(12, 2)
  description String
  subcategory String?
  date        DateTime
  categoryId  String
  paid        Boolean          @default(true)
  paidAt      DateTime?
  seriesId    String?
  seriesIndex Int?
  seriesTotal Int?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category         @relation(fields: [categoryId], references: [id])

  @@index([userId, date])
  @@index([userId, seriesId])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  limit      Decimal  @db.Decimal(12, 2)
  month      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

model Alert {
  id        String        @id @default(cuid())
  userId    String
  type      AlertType
  severity  AlertSeverity
  message   String
  status    AlertStatus   @default(ACTIVE)
  origin    AlertOrigin   @default(IA)
  createdAt DateTime      @default(now())
  readAt    DateTime?
  transactionIds Json?
  homeDisplayUntil DateTime?
  resolvedAt  DateTime?
  data        Json?

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  closing   MonthClosing? @relation(fields: [closingId], references: [id], onDelete: Cascade)
  closingId String?       @unique
  projection   MonthProjection? @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  projectionId String?          @unique
  projectionD2   MonthProjectionD2? @relation(fields: [projectionD2Id], references: [id], onDelete: Cascade)
  projectionD2Id String?               @unique

  @@index([userId, status])
  @@index([userId, type, status])
}

model MonthProjection {
  id               String                          @id @default(cuid())
  userId           String
  year             Int
  month            Int
  analyzedAt       DateTime                        @default(now())
  received         Decimal                         @db.Decimal(12, 2)
  pendingIncome    Decimal                         @db.Decimal(12, 2)
  paid             Decimal                         @db.Decimal(12, 2)
  pendingExpense   Decimal                         @db.Decimal(12, 2)
  balance          Decimal                         @db.Decimal(12, 2)
  projectedBalance Decimal                         @db.Decimal(12, 2)
  classification   MonthProjectionClassification
  message          String
  origin           MonthProjectionOrigin           @default(IA)
  createdAt        DateTime                        @default(now())

  user             User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert            Alert?

  @@unique([userId, year, month])
  @@index([userId, classification])
}

model MonthProjectionD2 {
  id               String                          @id @default(cuid())
  userId           String
  year             Int
  month            Int
  analyzedAt       DateTime                        @default(now())
  received         Decimal                         @db.Decimal(12, 2)
  pendingIncome    Decimal                         @db.Decimal(12, 2)
  paid             Decimal                         @db.Decimal(12, 2)
  pendingExpense   Decimal                         @db.Decimal(12, 2)
  balance          Decimal                         @db.Decimal(12, 2)
  projectedBalance Decimal                         @db.Decimal(12, 2)
  classification   MonthProjectionClassification

  d5ProjectedBalance  Decimal                     @db.Decimal(12, 2)
  d5Classification    MonthProjectionClassification

  projectionDifference Decimal                   @db.Decimal(12, 2)
  variationType       MonthProjectionD2Variation
  classificationChanged Boolean                   @default(false)
  facts               Json?

  message             String
  origin              MonthProjectionOrigin       @default(IA)
  createdAt           DateTime                    @default(now())

  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert               Alert?

  @@unique([userId, year, month])
  @@index([userId, classification])
}

model MonthClosing {
  id               String                      @id @default(cuid())
  userId           String
  year             Int
  month            Int
  status           MonthClosingStatus          @default(PENDENTE)
  classification   MonthClosingClassification?
  balance          Decimal                     @db.Decimal(12, 2)
  received         Decimal                     @db.Decimal(12, 2)
  paid             Decimal                     @db.Decimal(12, 2)
  pendingExpense   Decimal                     @db.Decimal(12, 2)
  pendingIncome    Decimal                     @db.Decimal(12, 2)
  message          String
  origin           MonthClosingOrigin          @default(IA)
  views            Int                         @default(0)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert            Alert?

  @@unique([userId, year, month])
  @@index([userId, status])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  status      PaymentStatus @default(PENDING)
  plan        String        @default("mensal")
  amountBRL   Decimal       @db.Decimal(12, 2)
  mpPaymentId String?
  mpPreferenceId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
