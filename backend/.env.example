# Porta do servidor
PORT=4000

# URL do banco PostgreSQL (Railway fornece DATABASE_URL automaticamente)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/guiasense"

# JWT
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Frontend (para CORS)
FRONTEND_URL="http://localhost:3000"

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
PLAN_PRICE_BRL="19.90"

# Focus NFe (emissão de NFS-e)
# Ambiente: homologacao | producao
FOCUS_NFE_ENV="homologacao"
FOCUS_NFE_TOKEN_HOMOLOGACAO=""
FOCUS_NFE_TOKEN_PRODUCAO=""
# Segredo opcional para validar as notificações do webhook da Focus (header Authorization)
FOCUS_NFE_WEBHOOK_SECRET=""
# Dados do prestador (empresa emissora)
FOCUS_NFE_EMITTER_CNPJ=""
FOCUS_NFE_EMITTER_IM=""
FOCUS_NFE_EMITTER_IBGE=""
FOCUS_NFE_EMITTER_SIMPLES="true"
FOCUS_NFE_EMITTER_REGIME="6"
# Dados do serviço
FOCUS_NFE_SERVICE_ITEM=""
FOCUS_NFE_SERVICE_TAX_CODE=""
FOCUS_NFE_SERVICE_RATE=""
FOCUS_NFE_SERVICE_DISCRIMINATION="Assinatura do plano {plano} do GuiaSense - licenciamento de uso de software de gestao financeira pessoal (SaaS)."
